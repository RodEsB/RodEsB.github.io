---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { content, blogHome, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const posts = (await getCollection('blog', (p) => p.id.startsWith(`${lang}/`) && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-MX', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base lang={lang} title={t.blog.title} description={t.blog.intro} altPath={blogHome(other)}>
  <section class="section page">
    <h1>{t.blog.title}</h1>
    <p class="intro">{t.blog.intro}</p>
    {posts.length === 0 ? (
      <p class="muted">{t.blog.empty}</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`${blogHome(lang)}${post.id.split('/').pop()}/`}>
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding-top: clamp(8rem, 16vw, 11rem); min-height: 80vh; }
  h1 { font-size: clamp(3rem, 9vw, 6rem); letter-spacing: -0.04em; }
  .intro { color: var(--muted); font-size: 1.16rem; max-width: 46ch; margin: 1.2rem 0 3rem; }
  .posts { list-style: none; padding: 0; margin: 0; max-width: 46rem; }
  .posts li { border-top: 1px solid var(--line); }
  .posts a { display: block; padding: 1.8rem 0; text-decoration: none; }
  .posts time { color: var(--muted); font-size: 0.92rem; }
  .posts h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); margin: 0.35rem 0 0.5rem; transition: color 0.15s; }
  .posts a:hover h2 { color: var(--accent-soft); }
  .posts p { color: var(--muted); }
</style>
