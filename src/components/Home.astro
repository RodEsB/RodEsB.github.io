---
import Base from '../layouts/Base.astro';
import AgentScene from './AgentScene.astro';
import FatigueArt from './FatigueArt.astro';
import TrustyArt from './TrustyArt.astro';
import OnboardingArt from './OnboardingArt.astro';
import ContactForm from './ContactForm.astro';
import { content, links, skills, home, blogHome, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<Base lang={lang} altPath={home(other)} field="hero">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Rodrigo Espíritu Berra',
    url: 'https://rodesb.github.io/',
    jobTitle: 'AI and Automation Consultant',
    worksFor: { '@type': 'Organization', name: 'Ellucian' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de las Américas Puebla' },
    address: { '@type': 'PostalAddress', addressLocality: 'Puebla', addressCountry: 'MX' },
    knowsLanguage: ['es', 'en'],
    sameAs: [links.github, links.linkedin, links.x],
  })} />
  <section class="hero">
    <h1>
      {t.hero.lines.map((line, i) => (
        <span class="line"><span style={`--i:${i}`}>{line}</span></span>
      ))}
    </h1>
    <p class="hero-lede">{t.hero.lede}</p>
    <p class="hero-actions">
      <a class="btn" href="#projects">{t.hero.primary}</a>
      <a class="btn ghost" href="#contact">{t.hero.secondary}</a>
    </p>
    <p class="hero-hint">{t.hero.hint}</p>
  </section>

  <section class="section" id="about">
    <h2>{t.about.title}</h2>
    <div class="about-grid">
      <div class="prose lead">
        {t.about.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="skills">
        <h3>{t.about.skillsTitle}</h3>
        <dl>
          {skills.map((g) => (
            <div>
              <dt>{g[lang]}</dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <h2>{t.experience.title}</h2>
    <ol class="timeline">
      {t.experience.items.map((job) => (
        <li>
          <p class="when">{job.period}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="where">{job.company}</p>
            {'text' in job && <p class="what">{job.text}</p>}
            {'points' in job && (
              <ul class="what points">
                {job.points.map((pt) => <li>{pt}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="projects">
    <h2>{t.projects.title}</h2>
    <div class="projects">
      {t.projects.items.map((p) => (
        <article class={`project project-${p.id}`}>
          <div class="project-text">
            <p class="muted">{p.context}</p>
            <h3>{p.name}</h3>
            <p class="project-body">{p.text}</p>
            <ul class="points project-points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <ul class="stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            {'url' in p && <p><a class="text-link" href={p.url}>{t.projects.repo}</a></p>}
          </div>
          <div class="project-art">
            {p.id === 'agent' && <AgentScene label={t.projects.altAgent} hint={t.projects.dragHint} />}
            {p.id === 'onboarding' && (
              <OnboardingArt label={t.projects.altOnboarding} question={t.projects.onbQuestion} kb={t.projects.onbKb} sources={t.projects.onbSources} />
            )}
            {p.id === 'fatigue' && (
              <FatigueArt label={t.projects.altFatigue} awake={t.projects.fatigueAwake} alert={t.projects.fatigueAlert} />
            )}
            {p.id === 'trusty' && (
              <TrustyArt label={t.projects.altTrusty} analyzing={t.projects.trustyAnalyzing} ready={t.projects.trustyReady} sources={t.projects.trustySources} />
            )}
          </div>
        </article>
      ))}
    </div>
    <h3 class="more-title">{t.more.title}</h3>
    <ul class="more">
      {t.more.items.map((m) => (
        <li>
          <h4><a href={m.url}>{m.name}</a> <span>{m.year}</span></h4>
          <p>{m.text}</p>
          <p class="more-stack">{m.stack}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="competitions">
    <h2>{t.competitions.title}</h2>
    <ol class="timeline plain">
      {t.competitions.items.map((c) => (
        <li>
          <p class="when">{c.period}</p>
          <div>
            <h3>{c.name}</h3>
            {'result' in c && <p class="result">{c.result}</p>}
            <p class="what">{c.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section blog-teaser">
    <h2>{t.blogTeaser.title}</h2>
    <p class="lead">{t.blogTeaser.text}</p>
    <p><a class="btn ghost" href={blogHome(lang)}>{t.blogTeaser.all}</a></p>
  </section>

  <section class="section contact" id="contact">
    <h2>{t.contact.title}</h2>
    <p class="lead prose">{t.contact.text}</p>
    {links.formspree && <ContactForm lang={lang} />}
    <p class="contact-actions">
      <a class={links.formspree ? 'btn ghost' : 'btn'} href={links.email}>{t.contact.email}</a>
      <a class="btn ghost" href={links.linkedin}>LinkedIn</a>
      <a class="btn ghost" href={links.github}>GitHub</a>
      <a class="btn ghost" href={links.x}>X</a>
      <a class="btn ghost" href={links.resume} download>{t.nav.resume}</a>
    </p>
  </section>
</Base>

<style>
  /* Inicio */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6.5rem var(--gutter) 4rem;
    max-width: 82rem;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.4vw, 6.6rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: 11.5em;
  }
  .hero .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero .line > span {
    display: block;
    transform: translateY(105%);
    animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.11s + 0.15s);
  }
  @keyframes rise { to { transform: translateY(0); } }
  .hero-lede {
    max-width: 34rem;
    margin-top: 1.8rem;
    font-size: 1.16rem;
    color: var(--muted);
    opacity: 0;
    animation: appear 0.8s ease 0.7s forwards;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
    opacity: 0;
    animation: appear 0.8s ease 0.85s forwards;
  }
  .hero-hint {
    position: absolute;
    right: var(--gutter);
    bottom: 2.2rem;
    font-size: 0.86rem;
    color: var(--muted);
    opacity: 0;
    animation: appear 1s ease 1.8s forwards;
  }
  @keyframes appear { to { opacity: 1; } }
  @media (hover: none), (max-width: 860px) { .hero-hint { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero .line > span { transform: none; }
    .hero-lede, .hero-actions, .hero-hint { opacity: 1; }
  }

  .lead { font-size: 1.16rem; }

  /* Sobre mí */
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); }
  .skills h3 { font-size: 1.35rem; margin-bottom: 1.2rem; }
  .skills dl { margin: 0; display: grid; gap: 1.2rem; }
  .skills dt { font-weight: 600; color: var(--accent-soft); margin-bottom: 0.15rem; }
  .skills dd { margin: 0; color: var(--muted); }

  /* Experiencia: línea de tiempo, de lo más reciente a lo más antiguo */
  .timeline { list-style: none; margin: 0; padding: 0; max-width: 60rem; }
  .timeline > li {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.7rem 0 1.7rem 1.6rem;
    border-left: 1px solid var(--line);
    position: relative;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 2.25rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }
  .timeline > li:first-child::before { background: var(--accent); box-shadow: 0 0 0 5px rgba(122, 92, 255, 0.22); }
  .when { color: var(--muted); font-size: 0.95rem; padding-top: 0.3rem; }
  .timeline h3 { font-size: 1.45rem; letter-spacing: -0.015em; line-height: 1.15; }
  .where { color: var(--accent-soft); font-weight: 600; margin-top: 0.2rem; }
  .what { color: var(--muted); margin-top: 0.55rem; max-width: 56ch; }
  .points { list-style: none; padding: 0; margin-bottom: 0; display: grid; gap: 0.45rem; }
  .points li { position: relative; padding-left: 1.1rem; }
  .points li::before { content: ''; position: absolute; left: 0; top: 0.68em; width: 6px; height: 1.5px; background: var(--accent); }
  .timeline.plain > li:first-child::before { background: var(--line); box-shadow: none; }
  .result {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent-strong);
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
  }

  /* Más proyectos: lista compacta */
  .more-title { font-size: clamp(1.5rem, 3vw, 2rem); margin: clamp(4rem, 9vw, 7rem) 0 0.6rem; }
  .more { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 6vw, 5rem); }
  .more li { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .more h4 { font-family: var(--display); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.015em; margin: 0 0 0.4rem; }
  .more h4 a { text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .more h4 a:hover { color: var(--accent-soft); }
  .more h4 span { font-family: var(--body); font-size: 0.9rem; font-weight: 400; color: var(--muted); margin-left: 0.4rem; }
  .more p { color: var(--muted); max-width: 46ch; }
  .more .more-stack { color: var(--accent-soft); font-size: 0.9rem; margin-top: 0.5rem; }

  /* Proyectos */
  .projects { display: grid; gap: clamp(3.5rem, 9vw, 7rem); }
  .project { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .project-art { position: sticky; top: 6rem; }
  .project:nth-child(even) .project-art { order: -1; }
  .project h3 { font-size: clamp(1.9rem, 4vw, 3rem); margin: 0.3rem 0 1rem; }
  .project-body { max-width: 52ch; }
  .project-points { color: var(--muted); max-width: 52ch; margin-top: 1.1rem; font-size: 0.97rem; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0; margin: 1.3rem 0 1.4rem; }
  .stack li { font-size: 0.86rem; color: var(--accent-soft); border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.75rem; }
  .text-link { color: var(--ink); font-weight: 600; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .text-link:hover { color: var(--accent-soft); }

  .project-art { display: flex; justify-content: center; }

  /* Blog y contacto */
  .blog-teaser .lead { color: var(--muted); margin-bottom: 1.5rem; }
  .contact { padding-bottom: clamp(5rem, 12vw, 9rem); }
  .contact h2 { font-size: clamp(3rem, 10vw, 7.5rem); letter-spacing: -0.04em; }
  .contact .lead { color: var(--muted); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2rem; }

  @media (max-width: 520px) {
    .hero h1 { font-size: 9.4vw; }
  }

  @media (max-width: 860px) {
    .about-grid, .project, .more { grid-template-columns: minmax(0, 1fr); }
    .project:nth-child(even) .project-art { order: 0; }
    .project-art { position: static; }
    .timeline > li { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
    .hero { justify-content: flex-end; padding-bottom: 3rem; }
  }
</style>
